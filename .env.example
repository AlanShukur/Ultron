# Copy this file to .env and fill in values locally. Never share your tokens.
DISCORD_TOKEN=replace_with_your_discord_bot_token
DISCORD_CLIENT_ID=replace_with_your_application_id
DISCORD_GUILD_ID=replace_with_your_server_id
# Local AI: no OpenAI key or credits required.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=dolphin-mistral:7b

# Optional: set AI_PROVIDER=openai to use the paid OpenAI API instead.
# OPENAI_API_KEY=replace_with_your_openai_api_key
# OPENAI_MODEL=gpt-4.1-mini
